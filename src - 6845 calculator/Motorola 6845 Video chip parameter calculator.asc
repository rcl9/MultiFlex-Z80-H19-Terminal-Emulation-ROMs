10 ' This program calculates video parameters for the Motorola 6845 Video chip.
20 '
30 ' By RCL9 (Rob's Retro Computing Archive) - RetroComputingArchive@gmail.com, github.com/rcl9
40 ' August 18 1986
50 '
60 PRINT CHR$(12)         ' clear the screen
70 PRINT:PRINT"6845 Video Parameter Calculator.":PRINT
80 PRINT"Hit RETURN for default values.":PRINT
90 PRINT"Program Interlace video just like any other format (ie. 48*80)":PRINT
100 PRINT:INPUT "Oscilator dot frequency (ie. 13e6) ";DOTCLOCK
110 IF DOTCLOCK = 0 THEN DOTCLOCK = 1.3E+07
120 PRINT:INPUT"Clock divider to get character clock (ie. 6) "; DIV
130 IF DIV = 0 THEN DIV = 6
140 PRINT:INPUT"Horizontal sync width (0.000 005 sec) ";SYNCWIDTH
150 IF SYNCWIDTH = 0 THEN SYNCWIDTH = .000005
160 PRINT:INPUT"Horizontal freq (15750) ";HORFREQ
170 IF HORFREQ = 0 THEN HORFREQ = 15750
180 PRINT:INPUT"Vertical freq (60) ";A
190 IF A = 0 THEN A = 60
200 VERTFREQ = 1/A
210 PRINT:INPUT"Number of useable lines (242-256) (default 252) ";USEABLELINES
220 IF USEABLELINES = 0 THEN USEABLELINES = 252
230 :
240 PRINT:INPUT"Characters per line (80) ";CHARSPERLINE
250 IF CHARSPERLINE = 0 THEN CHARSPERLINE = 80
260 PRINT:INPUT"Number of rows (24) ";NUMOFROWS
270 IF NUMOFROWS = 0 THEN NUMOFROWS = 24
280 PRINT:INPUT"# of scan lines per character line (+ blank lines) (10) ";NUMLINES
290 IF NUMLINES = 0 THEN NUMLINES = 10
300 :
310 PRINT
320 CLOCK = DOTCLOCK / DIV
330 R0 = CLOCK / HORFREQ - 1
340 PRINT "R0 = ";HEX$(R0);"h."
350 R1 = CHARSPERLINE
360 PRINT "R1 = ";HEX$(R1);"h."
370 R3 = FIX(SYNCWIDTH * CLOCK)
380 R2 = FIX((R0+R1-R3)/2)
390 PRINT "R2 = ";HEX$(R2);"h."
400 PRINT "R3 = ";HEX$(R3);"h."
410 R4 = FIX((VERTFREQ / (NUMLINES * R0 /CLOCK)) - 1)
420 PRINT "R4 = ";HEX$(R4);"h."
430 R5 = USEABLELINES - (R4 * NUMLINES)
440 PRINT "R5 = ";HEX$(R5);"h."
450 R6 = NUMOFROWS
460 PRINT "R6 = ";HEX$(R6);"h.","   (divide by half for interlace)"
470 R7 = FIX((R4+R6)/2)
480 PRINT "R7 = ";HEX$(R7);"h.";"        (must be <= R4, make it = R6, "
490 PRINT"                  or R6/2 for interlace)"
500 PRINT "R8 = 0           (3 for interlace)."
510 R9 = NUMLINES - 1
520 PRINT "R9 = ";HEX$(R9);"h."
530 PRINT:PRINT"R10-R15          Implementation specific, see data sheet"
540 PRINT
550 PRINT"R7 can be any value <= R4. I get good results setting"
560 PRINT"R7=R6 (or R6/2 for interlace). Making R7 smaller moves"
570 PRINT"the image lower down on the picture tube."
580 PRINT
585 PRINT"If you find that part of the top line is not being"
586 PRINT"displayed then increase the number of useable lines to 256."
587 PRINT
590 PRINT"For interlaced video, R6 MUST be even (ie. 24 lines)"
600 PRINT"and R6 must be programmed to half the above value."
610 PRINT"R0 must be odd, R9 must be odd, and the cursor start"
620 PRINT"& end lines must both be even or odd."
630 END
"
610 